# Dependencies & build output
node_modules
dist

# Environment
.env
.env.local
.env.*.local

# macOS
.DS_Store

# Agent skills — installed per-developer via `npx skills add`, not part of
# the site. Tracked in skills-lock.json locally so installs are reproducible,
# but the skill content itself does not belong in this repo.
.agents/
skills-lock.json
.claude/skills/
.claude/settings.local.json

# MCP config with env-expanded secrets stays local
.mcp.json

# Raw source material for the product shots and the shirt sequence. The
# optimised assets the site actually loads are committed; these masters are
# large, unreferenced by any code, and would sit in git history forever.
public/images/products/*.png
public/images/products/*.zip
public/images/products/*.mp4
public/images/products/shirtvideo 2/
